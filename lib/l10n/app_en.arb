    "placeholders": {
      "delta": {
        "type": "String"
      },
      "cell": {
        "type": "int"
      }
    }
  },
  "adviceImbalanceUnderLoadTitle": "The delta only opens under current",
  "adviceImbalanceUnderLoadBody": "At rest the cells are even, but under load they spread {delta} V further apart. That is resistance, and nine times out of ten it is a loose or corroded connection rather than a bad cell. Check the bolt and busbar on cell {cell} before replacing anything.",
  "@adviceImbalanceUnderLoadBody": {
    "placeholders": {
      "delta": {
        "type": "String"
      },
      "cell": {
        "type": "int"
      }
    }
  },
  "adviceWeakCellTitle": "It is always the same cell",
  "adviceWeakCellBody": "Cell {cell} has been the lowest in {percent}% of readings. That is not noise: this is the cell that sets your real range and reaches cutoff first.",
  "@adviceWeakCellBody": {
