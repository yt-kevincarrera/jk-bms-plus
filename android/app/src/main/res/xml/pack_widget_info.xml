<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0 on purpose. Android would only honour a half-hour
     minimum anyway, and the widget has nothing new to say unless the app has
     taken a reading, so it is updated when that happens instead. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/pack_widget"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
