<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately plain. A widget is read at a glance from a metre away while
     putting a helmet on, so it carries the charge, the range, and when the
     reading is from. That last one is not decoration: the app is not connected
     most of the time, and a stale number with no timestamp reads as live. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_pack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#8B93A7"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/widget_soc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#E8EDF7"
            android:text="--" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#8B93A7"
            android:layout_marginStart="3dp"
            android:text="%" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#4C9AFF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <TextView
        android:id="@+id/widget_age"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#6B7280"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
</LinearLayout>
